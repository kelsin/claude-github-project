#!/usr/bin/env python3
"""Fake `claude` for tests. The daemon gives a worker almost no environment, so the settings sit in a JSON file next to the executable's
path as it was invoked (<path>.json: {"dir", "script", "missing"}). `--help` lists the flags cgp daemon needs, minus "missing". A headless
run records its argv, stdin, environment, cwd and process group in <dir>/call-<pid>.json, then acts out the file "script", keyed by the
story's item id (else "default"): {"sleep": s, "spawn": true (a grandchild that sleeps; its pid is recorded), "run": [[cgp args], ...],
"env": {...} for those, "result": text, "cost": usd, "exit": n}."""
import json, os, re, subprocess, sys, time

CONF = json.load(open(sys.argv[0] + ".json"))
FLAGS = ["--max-turns", "--max-budget-usd", "--permission-mode", "--allowedTools", "--disallowedTools", "--setting-sources",
         "--strict-mcp-config", "--verbose", "--output-format"]
if "--help" in sys.argv:
    print("Usage: claude [options]")
    for f in FLAGS:
        if f not in CONF.get("missing", []):
            print(f"  {f} <value>")
    sys.exit(0)

prompt = sys.stdin.read()
m = re.search(r"Story: item (\S+),", prompt)
item = m.group(1) if m else "?"
rec = {"argv": sys.argv[1:], "stdin": prompt, "env": dict(os.environ), "cwd": os.getcwd(), "pid": os.getpid(), "pgid": os.getpgrp(), "item": item}
d = CONF["dir"]
script = json.load(open(CONF["script"])) if os.path.exists(CONF["script"]) else {}
act = script.get(item, script.get("default", {}))
if act.get("spawn"):
    child = subprocess.Popen(["sleep", "60"])
    rec["childPid"] = child.pid
json.dump(rec, open(os.path.join(d, f"call-{os.getpid()}.json"), "w"))
print(json.dumps({"type": "system", "subtype": "init"}), flush=True)
for args in act.get("run", []):
    cgp = re.search(r"CGP=(\S+)", prompt).group(1)
    subprocess.run([sys.executable, cgp, *args], input=act.get("input"), text=True, capture_output=True, env={**os.environ, **act.get("env", {})})
time.sleep(act.get("sleep", 0))
if "exit" not in act or act["exit"] == 0:
    print(json.dumps({"type": "result", "is_error": False, "result": act.get("result", "done: ok"), "total_cost_usd": act.get("cost", 0.25)}))
sys.exit(act.get("exit", 0))
