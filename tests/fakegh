#!/usr/bin/env python3
"""Fake `gh` for tests: a tiny in-memory Projects v2 + issue comments, persisted in $FAKE_GH_DB."""
import json, os, re, sys

DB = os.environ["FAKE_GH_DB"]
db = json.load(open(DB))
args = sys.argv[1:]


def save():
    json.dump(db, open(DB, "w"))


def field(name):
    return next(f for f in db["fields"] if f["name"] == name)


def value(item, fname):
    v = item["values"].get(fname)
    if v is None:
        return None
    if "optionId" in v:
        opt = next((o for o in field(fname)["options"] if o["id"] == v["optionId"]), None)
        if opt is None:
            return None  # option deleted
        return {"__typename": "ProjectV2ItemFieldSingleSelectValue", "optionId": opt["id"], "name": opt["name"]}
    return {"__typename": "ProjectV2ItemFieldTextValue", "text": v["text"]}


def values(item, q):
    """The aliased fieldValueByName(name:"X") selections the query asked for."""
    return {a: value(item, n) for a, n in re.findall(r'(\w+): fieldValueByName\(name:"([^"]+)"\)', q)}


def seq(entry):
    """A list is a sequence of responses (consumed one per call, the last one repeats); anything else is constant."""
    if isinstance(entry, list):
        return entry.pop(0) if len(entry) > 1 else entry[0]
    return entry


if args[:1] == ["--version"]:
    print("gh version 2.0.0")
elif args[:2] == ["auth", "status"]:
    print(f"Token scopes: {db['scopes']}")
elif args[:2] == ["api", "user"]:
    print("kelsin")
elif args[0] == "pr" and args[1] in ("view", "merge", "checks", "update-branch"):
    repo, num = args[args.index("-R") + 1], args[2]
    key = f"{repo}#{num}"
    db.setdefault("calls", []).append(args)
    if args[1] == "view":
        prs = db.get("prs")
        if prs is not None and key not in prs:
            sys.exit(f"fakegh: no pull request {key}")
        v = seq(prs[key]) if prs is not None else seq(db.get("pr_view", {"state": "OPEN", "mergeStateStatus": "CLEAN", "mergeable": "MERGEABLE", "isDraft": False, "headRefOid": "aaa111", "headRefName": f"cgp/{num}"}))
        save()
        print(json.dumps(v))
    elif args[1] == "checks":
        r = seq(db["checks_seq"]) if "checks_seq" in db else db.get("checks", [])  # checks_seq: one response per call
        db["checks_calls"] = db.get("checks_calls", 0) + 1
        save()
        if isinstance(r, dict):  # {"rc": n, "stderr": "..."}
            print(r.get("stderr", ""), file=sys.stderr)
            sys.exit(r["rc"])
        print(json.dumps(r))
    elif args[1] == "merge":
        save()
        if "--auto" in args and db.get("auto_merge_unavailable"):
            sys.exit("auto-merge is not allowed for this repository")
        sys.exit(db.get("merge_rc", 0))
    else:
        save()
elif args[:2] == ["run", "view"]:
    print("\n".join(f"log line {n}" for n in range(100)))
elif args[:2] == ["api", "graphql"]:
    body = json.loads(sys.stdin.read())
    q, v = body["query"], body["variables"]
    errors = None
    if "updateProjectV2Field(" in q:
        f = next(x for x in db["fields"] if x["id"] == v["f"])
        f["options"] = [{"id": o.get("id", f"new{i}"), "name": o["name"], "color": o["color"]} for i, o in enumerate(v["o"])]
        r = {"updateProjectV2Field": {"projectV2Field": {"id": f["id"], "options": f["options"]}}}
    elif "createProjectV2Field" in q:
        f = {"id": f"F_{v['n']}", "name": v["n"], "dataType": v["t"],
             "options": [{"id": f"o_{o['name']}", "name": o["name"]} for o in (v["o"] or [])]}
        if not f["options"]:
            del f["options"]
        db["fields"].append(f)
        r = {"createProjectV2Field": {"projectV2Field": f}}
    elif "createProjectV2View" in q:
        db.setdefault("views", []).append({"id": f"V{len(db['views'])}", "name": v["n"], "layout": v["l"],
                                           "filter": "", "fieldIds": v["c"]["visibleFieldIds"]})
        r = {"createProjectV2View": {"projectV2View": {"id": db["views"][-1]["id"]}}}
    elif "updateProjectV2View" in q:
        view = next(x for x in db["views"] if x["id"] == v["v"])
        view.update({k: v[a] for a, k in (("n", "name"), ("f", "filter")) if a in v})
        if v.get("c"):
            view["fieldIds"] = v["c"]["visibleFieldIds"]
        r = {}
    elif "updateProjectV2ItemFieldValue" in q:
        fname = next(x["name"] for x in db["fields"] if x["id"] == v["f"])
        item = next(i for i in db["items"] if i["id"] == v["i"])
        item["values"][fname] = {"optionId": v["o"]} if "o" in v and "t" not in v else {"text": v["t"]}
        r = {}
    elif "clearProjectV2ItemFieldValue" in q:
        fname = next(x["name"] for x in db["fields"] if x["id"] == v["f"])
        next(i for i in db["items"] if i["id"] == v["i"])["values"].pop(fname, None)
        r = {}
    elif "items(first:100" in q:
        start, size = int(v.get("after") or 0), db.get("page_size") or len(db["items"])
        page = db["items"][start:start + size]
        more = start + size < len(db["items"])
        nodes = []
        for i in page:
            if i["id"] in db.get("broken_items", []):  # content unreadable: GraphQL nulls it and reports an error
                errors = [{"type": "FORBIDDEN", "message": f"cannot read content of {i['id']}"}]
            nodes.append({"id": i["id"], "isArchived": False,
                          "content": None if i["id"] in db.get("broken_items", []) else i["content"], **values(i, q)})
        r = {"node": {"items": {"pageInfo": {"hasNextPage": more, "endCursor": str(start + size) if more else None},
                                "nodes": nodes}}}
    elif "projectV2(number" in q:
        p = {"id": f"P{v['n']}", "title": f"Test Board {v['n']}", "url": f"https://github.com/orgs/acme/projects/{v['n']}",
             "repositories": {"nodes": [{"nameWithOwner": "acme/app"}]},
             "views": {"nodes": db.get("views", [])},
             "fields": {"nodes": [dict({"__typename": "x"}, **f) for f in db["fields"]]}}
        r = {"organization": {"projectV2": p}}
    elif "isArchived" in q and "node(id:$i)" in q:
        it = next(i for i in db["items"] if i["id"] == v["i"])
        r = {"node": {"id": it["id"], "isArchived": False, "content": it["content"], **values(it, q)}}
    elif "node(id:$i)" in q:
        it = next(i for i in db["items"] if i["id"] == v["i"])
        r = {"node": {"content": it["content"]}}
    elif "repository(owner" in q:
        r = {"repository": {"id": "R1"}}
    else:
        r = {}
    save()
    print(json.dumps({"data": r, **({"errors": errors} if errors else {})}))
    sys.exit(1 if errors else 0)  # like gh: any GraphQL error, even next to usable data, is exit 1
elif args[0] == "api" and any(re.match(r"repos/[^/]+/[^/]+/pulls/\d+/files", a) for a in args):
    m = re.match(r"repos/([^/]+/[^/]+)/pulls/(\d+)/files", next(a for a in args if a.startswith("repos/")))
    print(json.dumps([{"filename": f} for f in db.get("pr_files", {}).get(f"{m.group(1)}#{m.group(2)}", [])]))
elif args[0] == "api" and any(re.match(r"repos/[^/]+/[^/]+/(pulls/\d+/(comments|reviews)|collaborators/)", a) for a in args):
    path = next(a for a in args if a.startswith("repos/"))
    if "/collaborators/" in path:
        login = path.split("/collaborators/")[1].split("/")[0]
        print(json.dumps({"permission": db.get("perms", {}).get(login, "read")}))
    else:
        m = re.match(r"repos/([^/]+/[^/]+)/pulls/(\d+)/(comments|reviews)", path)
        print(json.dumps(db.get(f"pr_{m.group(3)}", {}).get(f"{m.group(1)}#{m.group(2)}", [])))
elif args[0] == "api":
    path = next(a for a in args[1:] if a.startswith("repos/"))
    mi = re.fullmatch(r"repos/([^/]+/[^/]+)/issues/(\d+)", path)
    if mi:
        key = f"{mi.group(1)}#{mi.group(2)}"
        if "-f" in args:
            db.setdefault("issue_bodies", {})[key] = args[args.index("-f") + 1][len("body="):]
            save()
        print(json.dumps({"body": db.get("issue_bodies", {}).get(key, "")}))
        sys.exit(0)
    m = re.match(r"repos/([^/]+/[^/]+)/issues/(\d+)/comments", path)
    key = f"{m.group(1)}#{m.group(2)}"
    if "-f" in args:
        body = args[args.index("-f") + 1][len("body="):]
        n = db["clock"] = db.get("clock", 0) + 1
        cm = {"body": body, "created_at": f"2026-01-01T00:00:{n:02d}Z", "user": {"login": "kelsin", "type": "User"}, "author_association": "OWNER",
              "html_url": f"https://github.com/{m.group(1)}/issues/{m.group(2)}#c{n}"}
        db["comments"].setdefault(key, []).append(cm)
        save()
        print(json.dumps(cm))
    else:
        print(json.dumps(db["comments"].get(key, [])))
else:
    sys.exit(f"fakegh: unhandled {args}")
