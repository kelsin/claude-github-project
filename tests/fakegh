#!/usr/bin/env python3
"""Fake `gh` for tests: a tiny in-memory Projects v2 + issue comments, persisted in $FAKE_GH_DB."""
import json, os, re, sys

DB = os.environ["FAKE_GH_DB"]
db = json.load(open(DB))
args = sys.argv[1:]


def save():
    json.dump(db, open(DB, "w"))


def field(name):
    return next(f for f in db["fields"] if f["name"] == name)


def value(item, fname):
    v = item["values"].get(fname)
    if v is None:
        return None
    if "optionId" in v:
        opt = next((o for o in field(fname)["options"] if o["id"] == v["optionId"]), None)
        if opt is None:
            return None  # option deleted
        return {"__typename": "ProjectV2ItemFieldSingleSelectValue", "optionId": opt["id"], "name": opt["name"]}
    return {"__typename": "ProjectV2ItemFieldTextValue", "text": v["text"]}


def values(item, q):
    """The aliased fieldValueByName(name:"X") selections the query asked for."""
    return {a: value(item, n) for a, n in re.findall(r'(\w+): fieldValueByName\(name:"([^"]+)"\)', q)}


def issue_id(key):
    """The issue's database id (REST `id`); db["issue_ids"] overrides the default 9000 + its number."""
    return db.get("issue_ids", {}).get(key) or 9000 + int(key.split("#")[1])


def seq(entry):
    """A list is a sequence of responses (consumed one per call, the last one repeats); anything else is constant."""
    if isinstance(entry, list):
        return entry.pop(0) if len(entry) > 1 else entry[0]
    return entry


if args[:1] == ["--version"]:
    print("gh version 2.0.0")
elif args[:2] == ["auth", "status"]:
    print(f"Token scopes: {db['scopes']}")
elif args[:2] == ["api", "user"]:
    print("kelsin")
elif args[0] == "pr" and args[1] in ("view", "merge", "checks", "update-branch", "ready"):
    repo, num = args[args.index("-R") + 1], args[2]
    key = f"{repo}#{num}"
    db.setdefault("calls", []).append(args)
    if args[1] == "view":
        prs = db.get("prs")
        if prs is not None and key not in prs:
            sys.exit(f"fakegh: no pull request {key}")
        v = seq(prs[key]) if prs is not None else seq(db.get("pr_view", {"state": "OPEN", "mergeStateStatus": "CLEAN", "mergeable": "MERGEABLE", "isDraft": False, "headRefOid": "aaa111", "headRefName": f"cgp/{num}", "isCrossRepository": False, "baseRefName": "main"}))
        if db.get("auto_merge_stuck"):  # --disable-auto did not take: the view still shows auto-merge armed
            v = dict(v, autoMergeRequest={"enabledAt": "2026-01-01T00:00:00Z"})
        save()
        print(json.dumps(v))
    elif args[1] == "checks":
        r = seq(db["checks_seq"]) if "checks_seq" in db else db.get("checks", [])  # checks_seq: one response per call
        db["checks_calls"] = db.get("checks_calls", 0) + 1
        save()
        if isinstance(r, dict):  # {"rc": n, "stderr": "..."}
            print(r.get("stderr", ""), file=sys.stderr)
            sys.exit(r["rc"])
        print(json.dumps(r))
    elif args[1] == "merge":
        save()
        if "--match-head-commit" in args and db.get("head_is") and args[args.index("--match-head-commit") + 1] != db["head_is"]:
            sys.exit("Head branch was modified. Review and try the merge again.")  # the pin refuses a head that moved
        if "--auto" in args and db.get("auto_merge_unavailable"):
            sys.exit("auto-merge is not allowed for this repository")
        sys.exit(db.get("merge_rc", 0))
    else:
        save()
elif args[:3] == ["api", "-X", "PUT"] and args[3].endswith("/update-branch"):
    db.setdefault("update_branch_calls", []).append(args)
    save()
    sys.exit(db.get("update_branch_rc", 0))
elif args[:2] == ["run", "view"]:
    print("\n".join(f"log line {n}" for n in range(100)))
elif args[:2] == ["api", "graphql"]:
    body = json.loads(sys.stdin.read())
    q, v = body["query"], body["variables"]
    errors = None
    if "blockedBy(" in q and db.get("no_blocked_by_field"):  # an older GitHub: the whole query is rejected
        print(json.dumps({"errors": [{"type": "undefinedField", "message": "Field 'blockedBy' doesn't exist on type 'Issue'"}]}))
        sys.exit(1)
    if "__type(" in q:
        r = {"__type": {"fields": [{"name": "number"}] + ([] if db.get("no_blocked_by_field") else [{"name": "blockedBy"}])}}
    elif "updateProjectV2Field(" in q:
        f = next(x for x in db["fields"] if x["id"] == v["f"])
        f["options"] = [{"id": o.get("id", f"new{i}"), "name": o["name"], "color": o["color"]} for i, o in enumerate(v["o"])]
        r = {"updateProjectV2Field": {"projectV2Field": {"id": f["id"], "options": f["options"]}}}
    elif "createProjectV2Field" in q:
        f = {"id": f"F_{v['n']}", "name": v["n"], "dataType": v["t"],
             "options": [{"id": f"o_{o['name']}", "name": o["name"]} for o in (v["o"] or [])]}
        if not f["options"]:
            del f["options"]
        db["fields"].append(f)
        r = {"createProjectV2Field": {"projectV2Field": f}}
    elif "createProjectV2View" in q:
        db.setdefault("views", []).append({"id": f"V{len(db['views'])}", "name": v["n"], "layout": v["l"],
                                           "filter": "", "fieldIds": v["c"]["visibleFieldIds"]})
        r = {"createProjectV2View": {"projectV2View": {"id": db["views"][-1]["id"]}}}
    elif "updateProjectV2View" in q:
        view = next(x for x in db["views"] if x["id"] == v["v"])
        view.update({k: v[a] for a, k in (("n", "name"), ("f", "filter")) if a in v})
        if v.get("c"):
            view["fieldIds"] = v["c"]["visibleFieldIds"]
        r = {}
    elif "addProjectV2ItemById" in q:
        issue = next(i for lst in db.get("repo_issues", {}).values() for i in lst if i["node_id"] == v["c"])
        item = {"id": f"item{len(db['items']) + 1}", "values": {}, "content": {
            "__typename": "Issue", "number": issue["number"], "title": issue["title"], "state": "OPEN", "url": issue["html_url"],
            "repository": {"nameWithOwner": issue["repo"]}}}
        db["items"].append(item)
        r = {"addProjectV2ItemById": {"item": {"id": item["id"]}}}
    elif "updateProjectV2ItemFieldValue" in q:
        fname = next(x["name"] for x in db["fields"] if x["id"] == v["f"])
        item = next(i for i in db["items"] if i["id"] == v["i"])
        item["values"][fname] = {"optionId": v["o"]} if "o" in v and "t" not in v else {"text": v["t"]}
        r = {}
    elif "clearProjectV2ItemFieldValue" in q:
        fname = next(x["name"] for x in db["fields"] if x["id"] == v["f"])
        next(i for i in db["items"] if i["id"] == v["i"])["values"].pop(fname, None)
        r = {}
    elif "items(first:100" in q:
        start, size = int(v.get("after") or 0), db.get("page_size") or len(db["items"])
        page = db["items"][start:start + size]
        more = start + size < len(db["items"])
        nodes = []
        for i in page:
            if i["id"] in db.get("broken_items", []):  # content unreadable: GraphQL nulls it and reports an error
                errors = [{"type": "FORBIDDEN", "message": f"cannot read content of {i['id']}"}]
            content = None if i["id"] in db.get("broken_items", []) else i["content"]
            if content and "blockedBy(" in q and content["__typename"] == "Issue":  # db["blocked_by"]["acme/app#1"] = [issue nodes]
                key = f"{content['repository']['nameWithOwner']}#{content['number']}"
                found = db.get("blocked_by", {}).get(key, [])
                content = dict(content, blockedBy={"totalCount": db.get("blocked_by_total", {}).get(key, len(found)), "nodes": found})
            nodes.append({"id": i["id"], "isArchived": False, "content": content, **values(i, q)})
        r = {"node": {"items": {"pageInfo": {"hasNextPage": more, "endCursor": str(start + size) if more else None},
                                "nodes": nodes}}}
    elif "projectV2(number" in q:
        p = {"id": f"P{v['n']}", "title": f"Test Board {v['n']}", "url": f"https://github.com/orgs/acme/projects/{v['n']}",
             "repositories": {"nodes": [{"nameWithOwner": r} for r in db.get("linked_repos", ["acme/app"])]},
             "views": {"nodes": [dict(x, visibleFields={"nodes": [{"id": i} for i in x.get("fieldIds", [])]}) for x in db.get("views", [])]},
             "fields": {"nodes": [dict({"__typename": "x"}, **f) for f in db["fields"]]}}
        r = {"organization": {"projectV2": p}}
    elif "isArchived" in q and "node(id:$i)" in q:
        it = next(i for i in db["items"] if i["id"] == v["i"])
        if db.get("status_seq", {}).get(it["id"]):  # one Status option id per read, the last one repeats (see merge-wait revocation)
            it["values"]["Status"] = {"optionId": seq(db["status_seq"][it["id"]])}
            save()
        r = {"node": {"id": it["id"], "isArchived": False, "content": it["content"], **values(it, q)}}
    elif "node(id:$i)" in q:
        it = next(i for i in db["items"] if i["id"] == v["i"])
        r = {"node": {"content": it["content"]}}
    elif "repository(owner" in q:
        r = {"repository": {"id": "R1"}}
    else:
        r = {}
    save()
    print(json.dumps({"data": r, **({"errors": errors} if errors else {})}))
    sys.exit(1 if errors else 0)  # like gh: any GraphQL error, even next to usable data, is exit 1
elif args[0] == "api" and any(re.match(r"repos/[^/]+/[^/]+/pulls/\d+/files", a) for a in args):
    m = re.match(r"repos/([^/]+/[^/]+)/pulls/(\d+)/files", next(a for a in args if a.startswith("repos/")))
    # db["pr_files"]["acme/app#1"]: names, or {"filename", "status", "previous_filename"}; served 100 to a page like `gh api --paginate`
    entries = [f if isinstance(f, dict) else {"filename": f} for f in db.get("pr_files", {}).get(f"{m.group(1)}#{m.group(2)}", [])]
    for i in range(0, max(len(entries), 1), 100):
        print(json.dumps(entries[i:i + 100]))
elif args[0] == "api" and any(re.match(r"repos/[^/]+/[^/]+/(pulls/\d+/(comments|reviews)|collaborators/)", a) for a in args):
    path = next(a for a in args if a.startswith("repos/"))
    if "/collaborators/" in path:
        login = path.split("/collaborators/")[1].split("/")[0]
        print(json.dumps({"permission": db.get("perms", {}).get(login, "read")}))
    else:
        m = re.match(r"repos/([^/]+/[^/]+)/pulls/(\d+)/(comments|reviews)", path)
        print(json.dumps(db.get(f"pr_{m.group(3)}", {}).get(f"{m.group(1)}#{m.group(2)}", [])))
elif args[0] == "api" and re.match(r"repos/[^/]+/[^/]+/deployments", next((a for a in args if a.startswith("repos/")), "")):
    path = next(a for a in args if a.startswith("repos/"))
    ms = re.search(r"/deployments/(\d+)/statuses", path)
    deps = db.get("deployments", [])
    print(json.dumps(next(d["statuses"] for d in deps if str(d["id"]) == ms.group(1)) if ms else [{"id": d["id"]} for d in deps]))
elif args[0] == "api" and re.match(r"repos/[^/]+/[^/]+/issues(\?|$)", next((a for a in args if a.startswith("repos/")), "")):
    path = next(a for a in args if a.startswith("repos/"))
    repo = re.match(r"repos/([^/]+/[^/]+)/issues", path).group(1)
    lst = db.setdefault("repo_issues", {}).setdefault(repo, [])
    if "-f" in args:  # create
        fields = {a.split("=", 1)[0]: a.split("=", 1)[1] for a in args if re.match(r"^(title|body)=", a)}
        n = max([i["number"] for l in db["repo_issues"].values() for i in l] + [100]) + 1
        issue = {"number": n, "node_id": f"I_{n}", "title": fields["title"], "body": fields.get("body", ""), "repo": repo, "labels": [],
                 "html_url": f"https://github.com/{repo}/issues/{n}"}
        lst.append(issue)
        save()
        print(json.dumps(issue))
    else:
        want = re.search(r"labels=([^&]+)", path)
        print(json.dumps([{"user": {"login": "kelsin"}, "author_association": "OWNER", **i}
                          for i in lst if not want or want.group(1) in [l["name"] for l in i["labels"]]]))
elif args[0] == "api" and any(re.fullmatch(r"repos/[^/]+/[^/]+/issues/\d+/dependencies/blocked_by", a) for a in args):
    path = next(a for a in args if a.startswith("repos/"))
    m = re.match(r"repos/([^/]+/[^/]+)/issues/(\d+)/", path)
    blocker_id = int(args[args.index("-F") + 1].split("=", 1)[1])
    db.setdefault("dependency_posts", []).append(args)
    if db.get("dependencies_rc"):
        save()
        sys.exit("fakegh: HTTP 403")
    ref = next(c for it in db["items"] for c in [it["content"]] if c.get("number") and issue_id(f"{c['repository']['nameWithOwner']}#{c['number']}") == blocker_id)
    db.setdefault("blocked_by", {}).setdefault(f"{m.group(1)}#{m.group(2)}", []).append(
        {"number": ref["number"], "state": ref["state"], "repository": ref["repository"], "author": {"login": "kelsin"}})
    save()
    print("{}")
elif args[0] == "api":
    path = next(a for a in args[1:] if a.startswith("repos/"))
    mi = re.fullmatch(r"repos/([^/]+/[^/]+)/issues/(\d+)", path)
    if mi:
        key = f"{mi.group(1)}#{mi.group(2)}"
        if "state=closed" in args:  # closing an issue: db["issue_closes"] records it, and the board item shows it closed
            db.setdefault("issue_closes", []).append(key)
            for it in db["items"]:
                if it["content"].get("number") == int(mi.group(2)) and it["content"].get("repository", {}).get("nameWithOwner") == mi.group(1):
                    it["content"]["state"] = "CLOSED"
            save()
        elif "-f" in args:
            db.setdefault("issue_bodies", {})[key] = args[args.index("-f") + 1][len("body="):]
            save()
        who = db.get("issue_authors", {}).get(key, {"login": "kelsin", "author_association": "OWNER"})
        print(json.dumps({"id": issue_id(key), "body": db.get("issue_bodies", {}).get(key, ""), "user": {"login": who["login"]},
                          "author_association": who["author_association"]}))
        sys.exit(0)
    m = re.match(r"repos/([^/]+/[^/]+)/issues/(\d+)/comments", path)
    key = f"{m.group(1)}#{m.group(2)}"
    if "-f" in args:
        body = args[args.index("-f") + 1][len("body="):]
        n = db["clock"] = db.get("clock", 0) + 1
        cm = {"body": body, "created_at": f"2026-01-01T00:00:{n:02d}Z", "user": {"login": "kelsin", "type": "User"}, "author_association": "OWNER",
              "html_url": f"https://github.com/{m.group(1)}/issues/{m.group(2)}#c{n}"}
        db["comments"].setdefault(key, []).append(cm)
        save()
        print(json.dumps(cm))
    else:
        print(json.dumps(db["comments"].get(key, [])))
else:
    sys.exit(f"fakegh: unhandled {args}")
