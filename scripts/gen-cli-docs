#!/usr/bin/env python3
"""Regenerate docs/cli.md from the command table in scripts/cgp_lib/cli.py (a test fails when it is out of date)."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "scripts"))

from cgp_lib.cli import COMMANDS  # noqa: E402


def render():
    lines = ["# CLI reference", "", "Generated by `scripts/gen-cli-docs` from the command table; do not edit. Output is JSON unless noted,",
             "errors go to stderr with a non-zero exit code (3: missing token scope, 4: guard violation, 5: board held by another session,",
             "6: which board?, 7: PR changed after review).", "", "| Command | Arguments | What it does |", "|---|---|---|"]
    for name, _, help_, args in COMMANDS:
        shown = " ".join(f"`{n}`" for names, kw in args for n in names[:1]) or ""
        lines.append(f"| `{name}` | {shown} | {help_} |")
    return "\n".join(lines) + "\n"


if __name__ == "__main__":
    with open(os.path.join(ROOT, "docs", "cli.md"), "w") as f:
        f.write(render())
